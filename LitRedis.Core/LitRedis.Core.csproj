<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(FirebendTargetFrameworks)</TargetFrameworks>
    <Version>5.0.0</Version>
    <LangVersion>latestmajor</LangVersion>
    <Bumper>4</Bumper>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Firebend Lit Redis Core</AssemblyTitle>
    <Description>Firebend Lit Redis</Description>
    <PackageTags>firebend;redis;cache;caching;lock;distributed;locking</PackageTags>
    <Authors>Firebend</Authors>
    <RepositoryUrl>https://github.com/firebend/lit-redis</RepositoryUrl>
    <PackageLicenseUrl>https://github.com/firebend/lit-redis/blob/main/LICENSE</PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/firebend/lit-redis</PackageProjectUrl>
    <PackageIconUrl>https://github.com/firebend/lit-redis/blob/main/nuget-image.png?raw=true</PackageIconUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
